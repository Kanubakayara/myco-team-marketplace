{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/check_bc_imports.py",
            "timeout": 10,
            "statusMessage": "dependency rule"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/commit_gate.sh",
            "timeout": 180,
            "statusMessage": "commit gate: lint + tests"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.py) cd \"$CLAUDE_PROJECT_DIR\" && uv run --quiet ruff format --quiet \"$f\" && { uv run --quiet ruff check --fix --quiet \"$f\" 1>&2 || exit 2; };; esac",
            "timeout": 30,
            "statusMessage": "ruff format + check"
          }
        ]
      }
    ]
  }
}
